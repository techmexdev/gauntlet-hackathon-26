{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "normalized-post.json",
  "title": "NormalizedPost",
  "type": "object",
  "required": [
    "bundle_id",
    "session_id",
    "ingest_source",
    "author_handle",
    "text",
    "content_hash",
    "captured_at"
  ],
  "properties": {
    "bundle_id": { "type": "string", "minLength": 1 },
    "session_id": { "type": "string", "minLength": 1 },
    "ingest_source": { "type": "string", "enum": ["live", "tape"] },
    "author_handle": { "type": "string", "minLength": 1 },
    "author_display_name": { "type": "string" },
    "text": { "type": "string" },
    "urls": { "type": "array", "items": { "type": "string", "format": "uri" } },
    "engagement": {
      "type": "object",
      "properties": {
        "likes": { "type": "integer", "minimum": 0 },
        "reposts": { "type": "integer", "minimum": 0 },
        "replies": { "type": "integer", "minimum": 0 }
      }
    },
    "content_hash": { "type": "string", "minLength": 1 },
    "captured_at": { "type": "string", "format": "date-time" },
    "posted_at": { "type": "string", "format": "date-time" },
    "post_id": { "type": "string" }
  },
  "additionalProperties": false
}
