{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "decision.json",
  "title": "Decision",
  "type": "object",
  "required": [
    "bundle_id",
    "session_id",
    "action",
    "reason_codes",
    "decided_at"
  ],
  "properties": {
    "bundle_id": { "type": "string", "minLength": 1 },
    "session_id": { "type": "string", "minLength": 1 },
    "action": { "type": "string", "enum": ["SHOW", "HIDE", "HOLD", "BLOCK"] },
    "reason_codes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "signal_score": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
    "category": {
      "type": ["string", "null"],
      "enum": ["news", "analysis", "engagement_bait", "personal", "promo", "noise", null]
    },
    "decided_at": { "type": "string", "format": "date-time" },
    "worker": { "type": "string" },
    "author_handle": { "type": "string" },
    "text_snippet": { "type": "string" },
    "agent_reasons": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "score_explanation": { "type": "string", "minLength": 1 },
    "policy_label": { "type": "string" },
    "cascade_meta": {
      "type": "object",
      "properties": {
        "heuristic_score": { "type": ["integer", "null"] },
        "llm_invoked": { "type": "boolean" },
        "final_worker": { "type": "string" },
        "latency_ms": { "type": ["integer", "null"] },
        "branch_trigger": { "type": "string" },
        "disagreement_delta": { "type": "number" },
        "llm_score": { "type": "integer" }
      }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "escalate": { "type": "boolean" },
    "commit_branch": { "type": "string" },
    "commit_rationale": {
      "type": "object",
      "properties": {
        "show_threshold": { "type": "integer" },
        "likes": { "type": "integer" },
        "guardrail_passed": { "type": "boolean" },
        "guardrail_codes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "confidence": { "type": ["number", "null"] },
        "escalate": { "type": ["boolean", "null"] }
      }
    }
  },
  "additionalProperties": false
}
