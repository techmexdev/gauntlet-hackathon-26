# Harness configuration
PORT=3847
AGENT=llm
DATABASE_PATH=./data/harness.db

# LLM scoring (optional — heuristic works without API key)
ANTHROPIC_API_KEY=

# Optional: set FORCE_LLM=1 to score every post with Claude (default: gray-band + escalate only)
# FORCE_LLM=1

# Optional: cap LLM API calls per session (default: unlimited)
# LLM_CALLS=5

# Log Anthropic API calls when they happen (set 0 to disable)
LLM_LOG=1

# Session recording
RECORD_TAPE=

# Optional: override default repo-root tapes/ directory
# TAPES_DIR=
